# Documentation only: the app does not load .env files.
# Prefer existing gh authentication. Never commit or paste a real token here.
IMPACT_POLL_SECONDS=300
IMPACT_TIMEOUT_SECONDS=10
IMPACT_CYCLE_SECONDS=120
IMPACT_MAX_REQUESTS=500
IMPACT_MAX_REPOSITORIES=10000
IMPACT_MAX_CHECK_REPOSITORIES=200
IMPACT_MAX_ASSESSMENTS=2000
IMPACT_DISCOVERY_SECONDS=15
IMPACT_DISCOVERY_REQUESTS=10
IMPACT_DISCOVERY_RESUME_SECONDS=5
IMPACT_WORKERS=4
IMPACT_PORT=8765

# Optional external AI planner. Disabled unless provider is explicitly set.
# Select a model available to your OpenAI project that supports Responses and
# strict Structured Outputs. No assumed/default model and no automatic retries.
# IMPACT_AI_PROVIDER=openai
# IMPACT_AI_MODEL=your-supported-model-id
# Set OPENAI_API_KEY securely in the server process environment, not this file.
